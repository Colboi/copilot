{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colpilot",
  "version": "0.1.0",
  "identifier": "com.colboiin.colpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Colpilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/colpilot-icon.ico"],
    "resources": [
      "../backend/main.py",
      "../backend/user_config.py",
      "../backend/process_manager.py",
      "../backend/requirements.txt",
      "../plugins"
    ]
  }
}
